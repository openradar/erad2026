ltiprocessing.Pool(\n        procs\n    )  # Pool of processors. Defaults to all available logical cores\n\n    results = []\n    # chunksize=1 means feed a process a new job as soon as the process is idle.\n    # In our case, this restricts the queue to one \"dispatcher\" which is faster.\n    r = pool.map_async(generate, fstrs, chunksize=1, callback=results.append)\n    r.wait()\n\n    return results[0]","key":"O4FRbkqfAT"},{"type":"outputs","id":"YuqiSoy6NxSuXh0Nw5K1q","children":[],"key":"qKoJZiXzS4"}],"key":"EjDPlhuVDP"},{"type":"block","children":[{"type":"heading","depth":2,"position":{"start":{"line":153,"column":1},"end":{"line":153,"column":1}},"children":[{"type":"text","value":"Feed the monster, asynchronously!","position":{"start":{"line":153,"column":1},"end":{"line":153,"column":1}},"key":"rowxIBXtTH"}],"identifier":"feed-the-monster-asynchronously","label":"Feed the monster, asynchronously!","html_id":"feed-the-monster-asynchronously","implicit":true,"key":"tAW3DD4t8A"}],"key":"ehzvNbU48G"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"before = time.time()\nofstrs = multi_generate(ifstrs)\nafter = time.time()\n\nprint(\"Processing time: %3.2f seconds\" % (after - before))","key":"BNHsF6I221"},{"type":"outputs","id":"sbByga5KIJBTor_3HJTlr","children":[{"type":"output","children":[],"jupyter_data":{"output_type":"stream","name":"stdout","text":"Processing time: 2.47 seconds\n"},"key":"rhi8HpgoWS"}],"key":"QueOvZ6cph"}],"key":"j0pWdnOXU1"},{"type":"block","children":[],"key":"MPnZGAB1po"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"","key":"CwSmLBfVUi"},{"type":"outputs","id":"mPk9UmMukis50ifh2g0bd","children":[],"key":"epJpPtMfJL"}],"key":"t11U4gbnMV"}],"key":"uOhjzFrjsm"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"Quality Control using DR","url":"/notebooks/baltrad/baltrad-short-cour