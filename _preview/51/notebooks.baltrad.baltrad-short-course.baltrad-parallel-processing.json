d":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# Both input and output are a list of file strings\ndef multi_generate(fstrs, procs=None):\n    pool = multiprocessing.Pool(\n        procs\n    )  # Pool of processors. Defaults to all available logical cores\n\n    results = []\n    # chunksize=1 means feed a process a new job as soon as the process is idle.\n    # In our case, this restricts the queue to one \"dispatcher\" which is faster.\n    r = pool.map_async(generate, fstrs, chunksize=1, callback=results.append)\n    r.wait()\n\n    return results[0]","key":"jfnVLT5cG8"},{"type":"outputs","id":"QBwxcjZrqHExEECzo6gvf","children":[],"key":"pvvxWeFG4O"}],"key":"cIohq1wUJh"},{"type":"block","children":[{"type":"heading","depth":2,"position":{"start":{"line":153,"column":1},"end":{"line":153,"column":1}},"children":[{"type":"text","value":"Feed the monster, asynchronously!","position":{"start":{"line":153,"column":1},"end":{"line":153,"column":1}},"key":"tBI8pkrJuC"}],"identifier":"feed-the-monster-asynchronously","label":"Feed the monster, asynchronously!","html_id":"feed-the-monster-asynchronously","implicit":true,"key":"iuQPJcAHbd"}],"key":"QjLaeDlL9o"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"before = time.time()\nofstrs = multi_generate(ifstrs)\nafter = time.time()\n\nprint(\"Processing time: %3.2f seconds\" % (after - before))","key":"jsvcXhVZIk"},{"type":"outputs","id":"585Ct0wZv-hT3JYaLM3fm","children":[{"type":"output","children":[],"jupyter_data":{"output_type":"stream","name":"stdout","text":"Processing time: 1.85 seconds\n"},"key":"XjTP2nEU6s"}],"key":"wx9knVNcE4"}],"key":"HcXZao2hQC"},{"type":"block","children":[],"key":"DPfsdOz5of"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"","key":"JKaJB8xsUg"},{"type":"outputs","id":"4ji7ZOE_jYh31P6qJMfu8","children":[],"key":"PxVH7r0tb5"}],"ke