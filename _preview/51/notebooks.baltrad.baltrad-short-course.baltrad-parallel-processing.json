ltiprocessing.Pool(\n        procs\n    )  # Pool of processors. Defaults to all available logical cores\n\n    results = []\n    # chunksize=1 means feed a process a new job as soon as the process is idle.\n    # In our case, this restricts the queue to one \"dispatcher\" which is faster.\n    r = pool.map_async(generate, fstrs, chunksize=1, callback=results.append)\n    r.wait()\n\n    return results[0]","key":"w51arfPEbv"},{"type":"outputs","id":"yoRRJUWw8En4S8aecr8JG","children":[],"key":"VBDAkj095f"}],"key":"I2lpOAjkn7"},{"type":"block","children":[{"type":"heading","depth":2,"position":{"start":{"line":153,"column":1},"end":{"line":153,"column":1}},"children":[{"type":"text","value":"Feed the monster, asynchronously!","position":{"start":{"line":153,"column":1},"end":{"line":153,"column":1}},"key":"YXM1m4TtDR"}],"identifier":"feed-the-monster-asynchronously","label":"Feed the monster, asynchronously!","html_id":"feed-the-monster-asynchronously","implicit":true,"key":"ec4KZ7plp6"}],"key":"HRe9Y37iar"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"before = time.time()\nofstrs = multi_generate(ifstrs)\nafter = time.time()\n\nprint(\"Processing time: %3.2f seconds\" % (after - before))","key":"SkXQ6rfaKy"},{"type":"outputs","id":"YpJ7nE1ihEMRHYd7xb4dK","children":[{"type":"output","children":[],"jupyter_data":{"output_type":"stream","name":"stdout","text":"Processing time: 2.49 seconds\n"},"key":"fc6bi5v9j4"}],"key":"EZ08El20lF"}],"key":"kDOJdSt8Ra"},{"type":"block","children":[],"key":"qRfbmgwynf"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"","key":"Vr96skawz6"},{"type":"outputs","id":"US441LjWhRFVpjwahdN0R","children":[],"key":"CjrP1bLG7i"}],"key":"drv7FfwhI9"}],"key":"JSvtHsC2Yb"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"Quality Control using DR","url":"/notebooks/baltrad/baltrad-short-cour