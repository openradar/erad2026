d":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# Both input and output are a list of file strings\ndef multi_generate(fstrs, procs=None):\n    pool = multiprocessing.Pool(\n        procs\n    )  # Pool of processors. Defaults to all available logical cores\n\n    results = []\n    # chunksize=1 means feed a process a new job as soon as the process is idle.\n    # In our case, this restricts the queue to one \"dispatcher\" which is faster.\n    r = pool.map_async(generate, fstrs, chunksize=1, callback=results.append)\n    r.wait()\n\n    return results[0]","key":"NaZw6rSPM7"},{"type":"outputs","id":"y8btZAGZel2rjk0bU2kKN","children":[],"key":"JQhhlw1yvO"}],"key":"FTz3OQHnfn"},{"type":"block","children":[{"type":"heading","depth":2,"position":{"start":{"line":153,"column":1},"end":{"line":153,"column":1}},"children":[{"type":"text","value":"Feed the monster, asynchronously!","position":{"start":{"line":153,"column":1},"end":{"line":153,"column":1}},"key":"a5gq6VPQ7e"}],"identifier":"feed-the-monster-asynchronously","label":"Feed the monster, asynchronously!","html_id":"feed-the-monster-asynchronously","implicit":true,"key":"N7Omzxlu7D"}],"key":"lp0Y3ELbr5"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"before = time.time()\nofstrs = multi_generate(ifstrs)\nafter = time.time()\n\nprint(\"Processing time: %3.2f seconds\" % (after - before))","key":"evkcnX6wtE"},{"type":"outputs","id":"BcWI-LZGClvysFi_fUoF5","children":[{"type":"output","children":[],"jupyter_data":{"output_type":"stream","name":"stdout","text":"Processing time: 2.39 seconds\n"},"key":"LPJ2XBU7w6"}],"key":"NUwmeQINa8"}],"key":"B33V56iTwW"},{"type":"block","children":[],"key":"jGFjzqwbk5"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"","key":"F3xG4grjHm"},{"type":"outputs","id":"ohZiHTq777dqflLyzPg0Y","children":[],"key":"cSwaaN6RA1"}],"ke