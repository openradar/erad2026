d":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# Both input and output are a list of file strings\ndef multi_generate(fstrs, procs=None):\n    pool = multiprocessing.Pool(\n        procs\n    )  # Pool of processors. Defaults to all available logical cores\n\n    results = []\n    # chunksize=1 means feed a process a new job as soon as the process is idle.\n    # In our case, this restricts the queue to one \"dispatcher\" which is faster.\n    r = pool.map_async(generate, fstrs, chunksize=1, callback=results.append)\n    r.wait()\n\n    return results[0]","key":"uaAth0l6Bp"},{"type":"outputs","id":"929RgLKc-2XaXVwQZiU1j","children":[],"key":"kmB3GbOd99"}],"key":"HlfVORzivt"},{"type":"block","children":[{"type":"heading","depth":2,"position":{"start":{"line":153,"column":1},"end":{"line":153,"column":1}},"children":[{"type":"text","value":"Feed the monster, asynchronously!","position":{"start":{"line":153,"column":1},"end":{"line":153,"column":1}},"key":"pTsgTqCKYb"}],"identifier":"feed-the-monster-asynchronously","label":"Feed the monster, asynchronously!","html_id":"feed-the-monster-asynchronously","implicit":true,"key":"FLAVjoKoUJ"}],"key":"qxItrAzYFr"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"before = time.time()\nofstrs = multi_generate(ifstrs)\nafter = time.time()\n\nprint(\"Processing time: %3.2f seconds\" % (after - before))","key":"QJqz40nNbb"},{"type":"outputs","id":"tebsZi3J-D4tJYyr57qlZ","children":[{"type":"output","children":[],"jupyter_data":{"output_type":"stream","name":"stdout","text":"Processing time: 2.42 seconds\n"},"key":"USAEv2kstj"}],"key":"ViONlhIZP9"}],"key":"DRcjQ4znm0"},{"type":"block","children":[],"key":"VNul6ObeLf"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"","key":"Y7fBKd8yAI"},{"type":"outputs","id":"OqoSiRIZ3SZKVE1ThHMnF","children":[],"key":"zurywF358B"}],"ke