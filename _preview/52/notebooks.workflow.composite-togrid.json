, filename in filenames.items():\n    ds = xr.open_dataset(filename, chunks={}).sel(vcp_time=case)\n    ds = ds.assign_coords(vcp_time=ds.vcp_time.dt.floor(\"5min\")).sortby(\"vcp_time\")\n    ctree[radar] = ds\ndisplay(ctree)","key":"RFN7ov2kOS"},{"type":"outputs","id":"HrjS12NvHLZeSoHAMjfW8","children":[{"type":"output","children":[],"jupyter_data":{"output_type":"display_data","metadata":{},"data":{"text/plain":{"content":"<xarray.DataTree>\nGroup: /\n├── Group: /jastrebac\n│       Dimensions:              (vcp_time: 35, y: 499, x: 499, azimuth: 360)\n│       Coordinates: (12/13)\n│         * vcp_time             (vcp_time) datetime64[ns] 280B 2017-08-12T15:05:00 ....\n│         * y                    (y) float64 4kB -3.293e+06 -3.294e+06 ... -3.791e+06\n│         * x                    (x) float64 4kB 4.437e+06 4.438e+06 ... 4.935e+06\n│         * azimuth              (azimuth) float64 3kB 0.5 1.5 2.5 ... 357.5 358.5 359.5\n│           time                 (vcp_time, azimuth) datetime64[ns] 101kB dask.array<chunksize=(35, 360), meta=np.ndarray>\n│           elevation            (azimuth) float64 3kB dask.array<chunksize=(360,), meta=np.ndarray>\n│           ...                   ...\n│           longitude            float64 8B ...\n│           latitude             float64 8B ...\n│           follow_mode          <U7 28B ...\n│           altitude             float64 8B ...\n│           prt_mode             <U7 28B ...\n│           spatial_ref          int64 8B ...\n│       Data variables:\n│           DBTH                 (vcp_time, y, x) float32 35MB dask.array<chunksize=(35, 499, 499), meta=np.ndarray>\n│           KDP                  (vcp_time, y, x) float32 35MB dask.array<chunksize=(35, 499, 499), meta=np.ndarray>\n│           RHOHV                (vcp_time, y, x) float32 35MB dask.array<chunksize=(35, 499, 499), meta=np.ndarray>\n│           WRADH                (vcp_time, y, x) float32 35MB dask.array<chunksize=(35, 499, 499), meta=np.ndarray>\n│         