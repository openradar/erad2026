d":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# Both input and output are a list of file strings\ndef multi_generate(fstrs, procs=None):\n    pool = multiprocessing.Pool(\n        procs\n    )  # Pool of processors. Defaults to all available logical cores\n\n    results = []\n    # chunksize=1 means feed a process a new job as soon as the process is idle.\n    # In our case, this restricts the queue to one \"dispatcher\" which is faster.\n    r = pool.map_async(generate, fstrs, chunksize=1, callback=results.append)\n    r.wait()\n\n    return results[0]","key":"b89XNhArSt"},{"type":"outputs","id":"jvrfTxPWcHntV5t2YP3K1","children":[],"key":"VUF3XI4JbP"}],"key":"DnUurA66DW"},{"type":"block","children":[{"type":"heading","depth":2,"position":{"start":{"line":153,"column":1},"end":{"line":153,"column":1}},"children":[{"type":"text","value":"Feed the monster, asynchronously!","position":{"start":{"line":153,"column":1},"end":{"line":153,"column":1}},"key":"itOK3X6ThO"}],"identifier":"feed-the-monster-asynchronously","label":"Feed the monster, asynchronously!","html_id":"feed-the-monster-asynchronously","implicit":true,"key":"sh6a6cN0Sw"}],"key":"TlMqn5Tp2h"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"before = time.time()\nofstrs = multi_generate(ifstrs)\nafter = time.time()\n\nprint(\"Processing time: %3.2f seconds\" % (after - before))","key":"dKihSIrGjH"},{"type":"outputs","id":"OR1JUPykxeJwgYB4zmode","children":[{"type":"output","children":[],"jupyter_data":{"output_type":"stream","name":"stdout","text":"Processing time: 1.87 seconds\n"},"key":"fsK1WCHKes"}],"key":"KjcEkh5gev"}],"key":"yPkAC4eN3c"},{"type":"block","children":[],"key":"VBv1DXsVCP"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"","key":"NWNt6MJRrI"},{"type":"outputs","id":"KfPUxNRtojmpTETRZwkVM","children":[],"key":"dzUbrk98cl"}],"ke