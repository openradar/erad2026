":"kz4qxhkUXd"},{"type":"emphasis","children":[{"type":"text","value":"et al.","key":"zmTcv5AE3f"}],"key":"W1QDbLBWza"},{"type":"text","value":" (2016)","key":"ESM2HbZpin"}],"kind":"narrative","label":"Ryzhkov_2016","identifier":"https://doi.org/10.1175/JTECH-D-15-0020.1","enumerator":"1","key":"viZ5YGAgWg"},{"type":"text","value":" used this technique to track the melting layer and dendritic growth zone (roughly -10 to -15 degrees Celsius) as precipitation evolves. In that layer, ice crystals grow into dendrites and begin to aggregate as they fall and partially melt; in a QVP this shows up as a ZDR increase (up to 1.5-2 dB), a RHOHV decrease, and a strong vertical gradient in Z, sometimes accompanied by a nonzero KDP as the vertical phase gradient responds to the changing hydrometeor population. Because a QVP only needs the routine PPI volumes a radar already collects, it lets researchers examine the time evolution of these microphysical processes continuously, and compare polarimetric radar observations directly against vertically pointing remote sensors.","position":{"start":{"line":75,"column":1},"end":{"line":75,"column":1}},"key":"nMMQ4E907r"}],"key":"dl0nKg1qQz"},{"type":"paragraph","position":{"start":{"line":77,"column":1},"end":{"line":77,"column":1}},"children":[{"type":"text","value":"QVPs assume precipitation is approximately uniform in a ring around the radar, so they are most reliable in widespread, layered precipitation. For an isolated convective cell the azimuthal average mixes in-storm and clear-air rays, but the technique remains a useful way to track how a storm’s vertical structure evolves as it approaches, passes over, and recedes from the radar — which is why we apply it here to the Jastrebac dual-polarization convective case (","position":{"start":{"line":77,"column":1},"end":{"line":77,"column":1}},"key":"Hr5MDsDLVS"},{"type":"crossReference","position":{"start":{"line":77,"column":1},"end":{"line":77,"column":1}},"children":[{"type":"text","value":"Convective Case 2017","position":{"start":{"line":54,"column":1},"end":{"line":54,"column":1}},"key":"wE2XXcDnkY"}],"identifier":"convective-case","label":"convective-case","kind":"heading","template":"{name}","resolved":true,"html_id":"convective-case","remote":true,"url":"/notebooks/workflow/convective-case-2017","dataUrl":"/notebooks.workflow.convective-case-2017.json","key":"RotkYfjc7G"},{"type":"text","value":") rather than the single-polarization data used for ","position":{"start":{"line":77,"column":1},"end":{"line":77,"column":1}},"key":"FFAnWe83Tv"},{"type":"crossReference","position":{"start":{"line":77,"column":1},"end":{"line":77,"column":1}},"children":[{"type":"text","value":"QPE","position":{"start":{"line":77,"column":1},"end":{"line":77,"column":1}},"key":"W6T30PaJv0"}],"identifier":"qpe-estimation","label":"qpe-estimation","kind":"heading","template":"{name}","resolved":true,"html_id":"qpe-estimation","remote":true,"url":"/notebooks/workflow/qpe-estimation","dataUrl":"/notebooks.workflow.qpe-estimation.json","key":"uGlrKGZ5bv"},{"type":"text","value":".","position":{"start":{"line":77,"column":1},"end":{"line":77,"column":1}},"key":"kEjLGFQnUo"}],"key":"p76tELxJ2j"},{"type":"heading","depth":2,"position":{"start":{"line":80,"column":1},"end":{"line":80,"column":1}},"children":[{"type":"text","value":"Claim Data","position":{"start":{"line":80,"column":1},"end":{"line":80,"column":1}},"key":"dk7XjxGYSU"}],"label":"qvp-claim-data","identifier":"qvp-claim-data","html_id":"qvp-claim-data","key":"KCBmOJr9On"},{"type":"paragraph","position":{"start":{"line":82,"column":1},"end":{"line":82,"column":1}},"children":[{"type":"text","value":"We use the ARCO data provided in ","position":{"start":{"line":82,"column":1},"end":{"line":82,"column":1}},"key":"o6iLcdhczv"},{"type":"link","position":{"start":{"line":82,"column":1},"end":{"line":82,"column":1}},"children":[{"type":"text","value":"Data Access — Serbian Rainbow Radar","key":"k6qPiXQwEg"}],"identifier":"intro-data-access","label":"intro-data-access","url":"/notebooks/data-access/intro-data-access","internal":true,"dataUrl":"/notebooks.data-access.intro-data-access.json","key":"wmAXzubq71"},{"type":"text","value":".","position":{"start":{"line":82,"column":1},"end":{"line":82,"column":1}},"key":"V9TLvJM0kr"}],"key":"cRrGGFNoKd"}],"key":"E3Wx12nUY7"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"OSN_ENDPOINT = \"https://umn1.osn.mghpcc.org\"\nBUCKET = \"nexrad-arco\"","key":"Yyrmhw7nlR"},{"type":"outputs","id":"8QYuJxB4a7nNG8JbjvSYT","children":[],"key":"IfgRM0F9FQ"}],"key":"R3ynUjgw3r"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"prefix = \"jastrebac_500m\"  # dual-pol, 12 × 360 × 500, 2017 + 2026 — convective case\n\nstorage = icechunk.s3_storage(\n    bucket=BUCKET,\n    prefix=prefix,\n    endpoint_url=OSN_ENDPOINT,\n    region=\"us-east-1\",\n    anonymous=True,\n    force_path_style=True,\n)\nrepo = icechunk.Repository.open(storage)\ndtree = xr.open_datatree(\n    repo.readonly_session(\"main\").store,\n    engine=\"zarr\",\n    consolidated=False,\n    chunks={},\n).sel(vcp_time=\"2017\")\ndisplay(dtree)\nroot = next(iter(dtree.keys())).split(\"/\")[0]","key":"uztrEXGfR2"},{"type":"outputs","id":"0N8bvz48wlA8-mxQcU8mF","children":[{"type":"output","children":[],"jupyter_data":{"output_type":"display_data","metadata":{},"data":{"text/plain":{"content_type":"text/plain","hash":"74a75330dec68e478c9966c96f5ba7c4","path":"/erad2026/_preview/50/build/74a75330dec68e478c9966c96f5ba7c4.txt"},"text/html":{"content_type":"text/html","hash":"1616932e93fb2e162780eaf5def83e59","path":"/erad2026/_preview/50/build/1616932e93fb2e162780eaf5def83e59.html"}}},"key":"ozS5qCvSno"}],"key":"eNTLVQG0Gt"}],"key":"KZIcTUKpoN"},{"type":"block","children":[{"type":"heading","depth":2,"position":{"start":{"line":111,"column":1},"end":{"line":111,"column":1}},"children":[{"type":"text","value":"Select the Highest Elevation","position":{"start":{"line":111,"column":1},"end":{"line":111,"column":1}},"key":"Xu4tWX39km"}],"identifier":"select-the-highest-elevation","label":"Select the Highest Elevation","html_id":"select-the-highest-elevation","implicit":true,"key":"gkb99k7AYP"},{"type":"paragraph","position":{"start":{"line":113,"column":1},"end":{"line":113,"column":1}},"children":[{"type":"text","value":"QVPs are computed from the steepest routinely available elevation angle: a steeper beam needs less range to reach a given height, which reduces horizontal drift and keeps the assumption that one azimuthal sweep samples a roughly co-located vertical column.","position":{"start":{"line":113,"column":1},"end":{"line":113,"column":1}},"key":"hqleS2E63A"}],"key":"kmPUwkEBDz"}],"key":"tn0oFPvzLT"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"sweeps = sorted(dtree[root].children, key=lambda s: int(s.split(\"_\")[-1]))\nsweep = sweeps[-1]\n\nswp = dtree[f\"{root}/{sweep}\"].to_dataset(inherit=\"all_coords\")\nelevation_deg = float(swp.sweep_fixed_angle.isel(vcp_time=0))\nprint(f\"Using {sweep} at {elevation_deg:.1f}\\N{DEGREE SIGN} elevation\")\ndisplay(swp)","identifier":"qvp-select-sweep-code","enumerator":"1","html_id":"qvp-select-sweep-code","key":"nPtd688EBJ"},{"type":"outputs","id":"MgZtW2I5S58m7dzFZpD2m","children":[{"type":"output","children":[],"jupyter_data":{"output_type":"stream","name":"stdout","text":"Using sweep_11 at 25.0° elevation\n"},"identifier":"qvp-select-sweep-outputs-0","html_id":"qvp-select-sweep-outputs-0","key":"nwDjGxLrcu"},{"type":"output","children":[],"jupyter_data":{"output_type":"display_data","metadata":{},"data":{"text/plain":{"content":"<xarray.Dataset> Size: 231MB\nDimensions:              (vcp_time: 35, azimuth: 360, range: 500)\nCoordinates: (12/14)\n  * vcp_time             (vcp_time) datetime64[ns] 280B 2017-08-12T15:05:06 ....\n  * azimuth              (azimuth) float64 3kB 0.5 1.5 2.5 ... 357.5 358.5 359.5\n    elevation            (azimuth) float64 3kB dask.array<chunksize=(360,), meta=np.ndarray>\n    time                 (vcp_time, azimuth) datetime64[ns] 101kB dask.array<chunksize=(1, 360), meta=np.ndarray>\n  * range                (range) float32 2kB 250.0 750.0 ... 2.492e+05 2.498e+05\n    z                    (azimuth, range) float64 1MB dask.array<chunksize=(180, 250), meta=np.ndarray>\n    ...                   ...\n    follow_mode          object 8B ...\n    prt_mode             object 8B ...\n    latitude             float64 8B ...\n    longitude            float64 8B ...\n    altitude             float64 8B ...\n    sweep_mode           object 8B ...\nData variables:\n    ZDR                  (vcp_time, azimuth, range) float32 25MB dask.array<chunksize=(1, 360, 500), meta=np.ndarray>\n    KDP                  (vcp_time, azimuth, range) float32 25MB dask.array<chunksize=(1, 360, 500), meta=np.ndarray>\n    PHIDP                (vcp_time, azimuth, range) float32 25MB dask.array<chunksize=(1, 360, 500), meta=np.ndarray>\n    VRADH                (vcp_time, azimuth, range) float32 25MB dask.array<chunksize=(1, 360, 500), meta=np.ndarray>\n    DBTH                 (vcp_time, azimuth, range) float32 25MB dask.array<chunksize=(1, 360, 500), meta=np.ndarray>\n    DBZH                 (vcp_time, azimuth, range) float32 25MB dask.array<chunksize=(1, 360, 500), meta=np.ndarray>\n    RHOHV                (vcp_time, azimuth, range) float32 25MB dask.array<chunksize=(1, 360, 500), meta=np.ndarray>\n    WRADH                (vcp_time, azimuth, range) float32 25MB dask.array<chunksize=(1, 360, 500), meta=np.ndarray>\n    ray_elevation_angle  (vcp_time, azimuth) float64 101kB dask.array<chunksize=(1, 360), meta=np.ndarray>\n    sweep_number         (vcp_time) float32 140B dask.array<chunksize=(1,), meta=np.ndarray>\n    uPhiDP               (vcp_time, azimuth, range) float32 25MB dask.array<chunksize=(1, 360, 500), meta=np.ndarray>\n    sweep_fixed_angle    (vcp_time) float32 140B dask.array<chunksize=(1,), meta=np.ndarray>","content_type":"text/plain"},"text/html":{"content_type":"text/html","hash":"9e511eec1ea5b0170fc0a4a4288f77df","path":"/erad2026/_preview/50/build/9e511eec1ea5b0170fc0a4a4288f77df.html"}}},"identifier":"qvp-select-sweep-outputs-1","html_id":"qvp-select-sweep-outputs-1","key":"uxoLXoOtvM"}],"identifier":"qvp-select-sweep-outputs","html_id":"qvp-select-sweep-outputs","key":"GKJV7bSeiN"}],"label":"qvp-select-sweep","identifier":"qvp-select-sweep","html_id":"qvp-select-sweep","key":"oTgiDIizUR"},{"type":"block","children":[{"type":"heading","depth":2,"position":{"start":{"line":126,"column":1},"end":{"line":126,"column":1}},"children":[{"type":"text","value":"Quality Control","position":{"start":{"line":126,"column":1},"end":{"line":126,"column":1}},"key":"LyGZJ8Paei"}],"identifier":"quality-control","label":"Quality Control","html_id":"quality-control","implicit":true,"key":"wRcNmSYFfB"},{"type":"admonition","kind":"note","children":[{"type":"admonitionTitle","children":[{"type":"text","value":"Note","key":"sCYCpzDkpl"}],"key":"Yw7sRXskRX"},{"type":"paragraph","position":{"start":{"line":129,"column":1},"end":{"line":129,"column":1}},"children":[{"type":"text","value":"A fraction of ","position":{"start":{"line":129,"column":1},"end":{"line":129,"column":1}},"key":"GXhg877lRi"},{"type":"inlineCode","value":"KDP","position":{"start":{"line":129,"column":1},"end":{"line":129,"column":1}},"key":"M4AYXb5fdt"},{"type":"text","value":" gates carry a “no reliable estimate” sentinel value (\\N{ALMOST EQUAL TO} -10 deg/km) rather than a physical value. Together with gates where ","position":{"start":{"line":129,"column":1},"end":{"line":129,"column":1}},"key":"YcbBZgW4Gi"},{"type":"inlineCode","value":"RHOHV","position":{"start":{"line":129,"column":1},"end":{"line":129,"column":1}},"key":"FXUDhihqTZ"},{"type":"text","value":" is below 0.7 — unlikely to be meteorological echo — these are excluded before azimuthal averaging.","position":{"start":{"line":129,"column":1},"end":{"line":129,"column":1}},"key":"L5EHI3TFaL"}],"key":"oEdUDLBan4"}],"key":"ZObidO3CiY"}],"key":"DIhOKC0Hgq"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"qc_mask = swp.RHOHV >= 0.7\nzdr = swp.ZDR.where(qc_mask)\nrhohv = swp.RHOHV.where(qc_mask)\nkdp = swp.KDP.where(qc_mask & (swp.KDP > -9))","key":"L8qkJWJ5tg"},{"type":"outputs","id":"6PZ9WgQQ3Ozx45hXSORmJ","children":[],"key":"ctc3yjbiPa"}],"key":"se9yF6vbm9"},{"type":"block","children":[{"type":"heading","depth":2,"position":{"start":{"line":139,"column":1},"end":{"line":139,"column":1}},"children":[{"type":"text","value":"Compute the QVP","position":{"start":{"line":139,"column":1},"end":{"line":139,"column":1}},"key":"urvhhpsPVy"}],"identifier":"compute-the-qvp","label":"Compute the QVP","html_id":"compute-the-qvp","implicit":true,"key":"GUVS05s48c"},{"type":"paragraph","position":{"start":{"line":141,"column":1},"end":{"line":141,"column":1}},"children":[{"type":"text","value":"Reflectivity must be averaged in linear units and converted back to dB afterwards — averaging directly in dB would bias the mean low, since dB compresses the dynamic range of the underlying (linear) received power. Height above the radar follows from simple trigonometry on the fixed elevation angle and range: ","position":{"start":{"line":141,"column":1},"end":{"line":141,"column":1}},"key":"Py7IeV9BTZ"},{"type":"inlineMath","value":"h = r \\sin\\theta_e","html":"<span class=\"katex\"><span class=\"katex-mathml\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><semantics><mrow><mi>h</mi><mo>=</mo><mi>r</mi><mi>sin</mi><mo>⁡</mo><msub><mi>θ</mi><mi>e</mi></msub></mrow><annotation encoding=\"application/x-tex\">h = r \\sin\\theta_e</annotation></semantics></math></span><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"base\"><span class=\"strut\" style=\"height:0.6944em;\"></span><span class=\"mord mathnormal\">h</span><span class=\"mspace\" style=\"margin-right:0.2778em;\"></span><span class=\"mrel\">=</span><span class=\"mspace\" style=\"margin-right:0.2778em;\"></span></span><span class=\"base\"><span class=\"strut\" style=\"height:0.8444em;vertical-align:-0.15em;\"></span><span class=\"mord mathnormal\" style=\"margin-right:0.02778em;\">r</span><span class=\"mspace\" style=\"margin-right:0.1667em;\"></span><span class=\"mop\">sin</span><span class=\"mspace\" style=\"margin-right:0.1667em;\"></span><span class=\"mord\"><span class=\"mord mathnormal\" style=\"margin-right:0.02778em;\">θ</span><span class=\"msupsub\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.1514em;\"><span style=\"top:-2.55em;margin-left:-0.0278em;margin-right:0.05em;\"><span class=\"pstrut\" style=\"height:2.7em;\"></span><span class=\"sizing reset-size6 size3 mtight\"><span class=\"mord mathnormal mtight\">e</span></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.15em;\"><span></span></span></span></span></span></span></span></span></span>","key":"WYchUmgM80"},{"type":"text","value":".","position":{"start":{"line":141,"column":1},"end":{"line":141,"column":1}},"key":"nFH2p5ug7f"}],"key":"zqyft4ToGV"},{"type":"admonition","kind":"seealso","children":[{"type":"admonitionTitle","children":[{"type":"text","value":"See Also","key":"PRsLKVLytR"}],"key":"R5HOsLgsVL"},{"type":"list","ordered":false,"spread":false,"position":{"start":{"line":144,"column":1},"end":{"line":144,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":144,"column":1},"end":{"line":144,"column":1}},"children":[{"type":"paragraph","children":[{"type":"cite","url":"https://doi.org/10.1175/JTECH-D-15-0020.1","position":{"start":{"line":144,"column":1},"end":{"line":144,"column":1}},"children":[{"type":"text","value":"Ryzhkov ","key":"e4CZbexUhe"},{"type":"emphasis","children":[{"type":"text","value":"et al.","key":"bepUMIVCle"}],"key":"jNuBV8GxgR"},{"type":"text","value":" (2016)","key":"T6oA9z5neS"}],"kind":"narrative","label":"Ryzhkov_2016","identifier":"https://doi.org/10.1175/JTECH-D-15-0020.1","enumerator":"1","key":"FwPVWxLYCx"},{"type":"text","value":" — the original QVP formulation","position":{"start":{"line":144,"column":1},"end":{"line":144,"column":1}},"key":"GChdEgEwFV"}],"key":"dD0MniDw2l"}],"key":"Slpu4PFuhn"}],"key":"I4ue1mylpX"}],"key":"X7vz6q4ZWb"}],"key":"qn4vmYX7LC"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"def azimuthal_mean(da, is_db=False):\n    lin = 10 ** (da / 10) if is_db else da\n    out = lin.mean(\"azimuth\", skipna=True)\n    return 10 * np.log10(out.where(out > 0)) if is_db else out\n\nelevation = np.deg2rad(elevation_deg)\nheight = (swp.range * np.sin(elevation) / 1000).assign_attrs(units=\"km\", long_name=\"Height above radar\")\n\nqvp = xr.Dataset(\n    {\n        \"DBZH\": azimuthal_mean(swp.DBZH, is_db=True),\n        \"ZDR\": azimuthal_mean(zdr),\n        \"RHOHV\": azimuthal_mean(rhohv),\n        \"KDP\": azimuthal_mean(kdp),\n    }\n).assign_coords(height=height)\nqvp = qvp.where(qvp.height <= 15, drop=True)\ndisplay(qvp)","key":"ak8fD17cVF"},{"type":"outputs","id":"wPFW0FS-LsJmjfVM0lB9X","children":[{"type":"output","children":[],"jupyter_data":{"output_type":"display_data","metadata":{},"data":{"text/plain":{"content":"<xarray.Dataset> Size: 41kB\nDimensions:      (vcp_time: 35, range: 71)\nCoordinates:\n  * vcp_time     (vcp_time) datetime64[ns] 280B 2017-08-12T15:05:06 ... 2017-...\n  * range        (range) float32 284B 250.0 750.0 ... 3.475e+04 3.525e+04\n    height       (range) float64 568B 0.1057 0.317 0.5283 ... 14.47 14.69 14.9\n    follow_mode  <U7 28B 'not_set'\n    prt_mode     <U7 28B 'not_set'\n    latitude     float64 8B 43.39\n    