ltiprocessing.Pool(\n        procs\n    )  # Pool of processors. Defaults to all available logical cores\n\n    results = []\n    # chunksize=1 means feed a process a new job as soon as the process is idle.\n    # In our case, this restricts the queue to one \"dispatcher\" which is faster.\n    r = pool.map_async(generate, fstrs, chunksize=1, callback=results.append)\n    r.wait()\n\n    return results[0]","key":"vWlpxtyNca"},{"type":"outputs","id":"jEsccs7WJykwyfHG-JJhm","children":[],"key":"f3n1Kom2bs"}],"key":"iMUZj5SNAJ"},{"type":"block","children":[{"type":"heading","depth":2,"position":{"start":{"line":153,"column":1},"end":{"line":153,"column":1}},"children":[{"type":"text","value":"Feed the monster, asynchronously!","position":{"start":{"line":153,"column":1},"end":{"line":153,"column":1}},"key":"UJXW633fRx"}],"identifier":"feed-the-monster-asynchronously","label":"Feed the monster, asynchronously!","html_id":"feed-the-monster-asynchronously","implicit":true,"key":"AM3N0jl5Y8"}],"key":"uRj7fC2j0P"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"before = time.time()\nofstrs = multi_generate(ifstrs)\nafter = time.time()\n\nprint(\"Processing time: %3.2f seconds\" % (after - before))","key":"EuwEGZXoaV"},{"type":"outputs","id":"YN2Ko3MgvuwDR4GldqIc-","children":[{"type":"output","children":[],"jupyter_data":{"output_type":"stream","name":"stdout","text":"Processing time: 2.53 seconds\n"},"key":"Jd0IDSFicY"}],"key":"NHioxoxqdA"}],"key":"dU0jeBMGAF"},{"type":"block","children":[],"key":"GQdlLp2o7B"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"","key":"yVrHqrMthA"},{"type":"outputs","id":"lGclIGUvckBFMwzB4q3x-","children":[],"key":"S2lYDbcZqG"}],"key":"HZpgIfhr2s"}],"key":"qWdRIyIzZ9"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"Quality Control using DR","url":"/notebooks/baltrad/baltrad-short-cour