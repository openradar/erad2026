d":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# Both input and output are a list of file strings\ndef multi_generate(fstrs, procs=None):\n    pool = multiprocessing.Pool(\n        procs\n    )  # Pool of processors. Defaults to all available logical cores\n\n    results = []\n    # chunksize=1 means feed a process a new job as soon as the process is idle.\n    # In our case, this restricts the queue to one \"dispatcher\" which is faster.\n    r = pool.map_async(generate, fstrs, chunksize=1, callback=results.append)\n    r.wait()\n\n    return results[0]","key":"tDPVfDnk67"},{"type":"outputs","id":"iNmxfFOwp589Ud6gYVelX","children":[],"key":"qfileGNo5V"}],"key":"Y07AVfuPon"},{"type":"block","children":[{"type":"heading","depth":2,"position":{"start":{"line":153,"column":1},"end":{"line":153,"column":1}},"children":[{"type":"text","value":"Feed the monster, asynchronously!","position":{"start":{"line":153,"column":1},"end":{"line":153,"column":1}},"key":"iUR0drd5Dx"}],"identifier":"feed-the-monster-asynchronously","label":"Feed the monster, asynchronously!","html_id":"feed-the-monster-asynchronously","implicit":true,"key":"KnENKMgKV7"}],"key":"haQpa3FdEL"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"before = time.time()\nofstrs = multi_generate(ifstrs)\nafter = time.time()\n\nprint(\"Processing time: %3.2f seconds\" % (after - before))","key":"RrezuxVG1r"},{"type":"outputs","id":"Arb-zaD_ErtFIqKI1nxk5","children":[{"type":"output","children":[],"jupyter_data":{"output_type":"stream","name":"stdout","text":"Processing time: 2.47 seconds\n"},"key":"e4ZNlpZqB8"}],"key":"PATZyhRXhT"}],"key":"cl0v2rP7R0"},{"type":"block","children":[],"key":"Z934KX3PHr"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"","key":"maEpGeO7bC"},{"type":"outputs","id":"hGna3pQbc9MMYxhCkl83m","children":[],"key":"UBXXLKSHvj"}],"ke