uer"},"name":"Kai Mühlbauer","orcid":"0000-0001-6599-1034","github":"kmuehlbauer","id":"contributors-myst-generated-uid-7"},{"nameParsed":{"literal":"Maxwell Grover","given":"Maxwell","family":"Grover"},"name":"Maxwell Grover","orcid":"0000-0002-0370-8974","github":"mgrover1","id":"contributors-myst-generated-uid-8"},{"nameParsed":{"literal":"Mike Dixon","given":"Mike","family":"Dixon"},"name":"Mike Dixon","orcid":"0000-0002-9597-9113","github":"mike-dixon","id":"contributors-myst-generated-uid-9"},{"nameParsed":{"literal":"Robert Jackson","given":"Robert","family":"Jackson"},"name":"Robert Jackson","orcid":"0000-0003-2518-1234","github":"rcjackson","id":"contributors-myst-generated-uid-10"},{"nameParsed":{"literal":"Scott Collis","given":"Scott","family":"Collis"},"name":"Scott Collis","orcid":"0000-0002-2303-687X","github":"scollis","id":"contributors-myst-generated-uid-11"},{"nameParsed":{"literal":"Ting-Yu Cha","given":"Ting-Yu","family":"Cha"},"name":"Ting-Yu Cha","orcid":"0000-0002-6292-8483","github":"tingyucha","id":"contributors-myst-generated-uid-12"},{"nameParsed":{"literal":"Zachary Sherman","given":"Zachary","family":"Sherman"},"name":"Zachary Sherman","orcid":"0000-0002-6455-8324","github":"zssherman","id":"contributors-myst-generated-uid-13"}],"github":"https://github.com/openradar/erad2026","copyright":"2026","settings":{"output_matplotlib_strings":"remove"},"numbering":{"title":{"offset":2}},"thumbnail":"/erad2026/_preview/66/build/hail_case_tracks-f65f2101f465af924d34773c428874c6.png","exports":[{"format":"md","filename":"Titan_preprocessing.md","url":"/erad2026/_preview/66/build/Titan_preprocessing-eec2aebcd267c0f9889be6422abe600b.md"}]},"mdast":{"type":"root","children":[{"type":"block","children":[{"type":"thematicBreak","position":{"start":{"line":15,"column":1},"end":{"line":15,"column":1}},"key":"LkDMdtjsMg"},{"type":"image","url":"/erad2026/_preview/66/build/hail_case_tracks-f65f2101f465af924d34773c428874c6.png","width":300,"height":300,"key":"JEsdDyr4ul","urlSource":"./images/hail_case_tracks.png"},{"type":"paragraph","position":{"start":{"line":19,"column":1},"end":{"line":19,"column":1}},"children":[{"type":"text","value":"This interactive tutorial takes you through the steps of how to preprocess data in order to run the Thunderstorm Identification, Tracking, Analysis and Nowcasting (Titan) suite. The key preprocessing steps for Titan include: 1) removing noise and non-meteorological echoes (and correcting any biases), and 2) converting from polar to Cartesian grids in the NCAR MDV format. This notebook provides a few examples using LROSE applications, but feel free to use your favorite package to pre-process the data.","position":{"start":{"line":19,"column":1},"end":{"line":19,"column":1}},"key":"Y8ou9DtN9x"}],"key":"oIgPnhFw5w"},{"type":"paragraph","position":{"start":{"line":21,"column":1},"end":{"line":21,"column":1}},"children":[{"type":"text","value":"Titan was originally designed as an algorithm to objectively identify and track thunderstorms from weather radar data for a weather modification experiment in South Africa in the 1980s. Now, Titan includes forecasting, storm analysis, and climatological analysis. Titan now refers to the larger system in which the original application is one component.","position":{"start":{"line":21,"column":1},"end":{"line":21,"column":1}},"key":"Mm2rkEBjoN"}],"key":"XOYSYnOnGk"},{"type":"paragraph","position":{"start":{"line":23,"column":1},"end":{"line":23,"column":1}},"children":[{"type":"text","value":"Titan is described in more detail in ","position":{"start":{"line":23,"column":1},"end":{"line":23,"column":1}},"key":"aG37N7VUcy"},{"type":"cite","url":"https://doi.org/10.1175/1520-0426(1993)010%3C0785:TTITAA%3E2.0.CO;2","position":{"start":{"line":23,"column":1},"end":{"line":23,"column":1}},"children":[{"type":"text","value":"Dixon and Wiener (1993)","position":{"start":{"line":23,"column":1},"end":{"line":23,"column":1}},"key":"Ty19Dplb0i"}],"kind":"narrative","label":"Dixon_1993","identifier":"https://doi.org/10.1175/1520-0426(1993)010%3C0785:TTITAA%3E2.0.CO;2","enumerator":"1","key":"nh7QtWjzLT"},{"type":"text","value":".","position":{"start":{"line":23,"column":1},"end":{"line":23,"column":1}},"key":"JOA0hT9N4S"}],"key":"X1wfIRVNWQ"},{"type":"thematicBreak","position":{"start":{"line":26,"column":1},"end":{"line":26,"column":1}},"key":"vdUWwM7SDT"},{"type":"heading","depth":2,"position":{"start":{"line":28,"column":1},"end":{"line":28,"column":1}},"children":[{"type":"strong","position":{"start":{"line":28,"column":1},"end":{"line":28,"column":1}},"children":[{"type":"text","value":"Titan Background","position":{"start":{"line":28,"column":1},"end":{"line":28,"column":1}},"key":"lOp7vIl1bu"}],"key":"C7GcxQ0o3f"}],"identifier":"titan-background","label":"Titan Background","html_id":"titan-background","implicit":true,"key":"W6M93U2VJr"},{"type":"paragraph","position":{"start":{"line":30,"column":1},"end":{"line":30,"column":1}},"children":[{"type":"text","value":"Titan identifies storm objects as a contiguous region of echo that exceeds a user-defined reflectivity threshold and minimum volume. Dual thresholds are used to deal with storm objects that briefly touch, but do not merge. Storm tracking is performed by looking for regions of overlap between storm objects at successive time intervals. Short term storm extrapolation forecasts are used to identify instances of storm merging and splitting. Titan output includes storm tracks, polygons outlining the storm objects, and storm property information (e.g., volume, area, mass, precipitation flux).","position":{"start":{"line":30,"column":1},"end":{"line":30,"column":1}},"key":"wkxXeUk9It"}],"key":"htRPd4YKDX"},{"type":"paragraph","position":{"start":{"line":32,"column":1},"end":{"line":32,"column":1}},"children":[{"type":"text","value":"The high-level workflow for Titan is shown in the graphic below. Key steps include quality controlling the data to remove any non-meteorological or compromised echoes and gridding the data to a Cartesian grid. Once Titan is run and the tracks are produced, those data need to be converted into more user-friendly file types.","position":{"start":{"line":32,"column":1},"end":{"line":32,"column":1}},"key":"RuZ5XHaKH2"}],"key":"AV1OSKbyzh"},{"type":"image","url":"/erad2026/_preview/66/build/titan_highlevel-821c065f70d4274809c0b88254c69407.png","width":600,"key":"PrKGW3gDYZ","urlSource":"./images/titan_highlevel.png"},{"type":"paragraph","position":{"start":{"line":36,"column":1},"end":{"line":36,"column":1}},"children":[{"type":"text","value":"A more detailed workflow for Titan that includes each step, application, and data type is shown in the graphic below.","position":{"start":{"line":36,"column":1},"end":{"line":36,"column":1}},"key":"jd4NntoKvj"}],"key":"JElJ7lU5oi"},{"type":"image","url":"/erad2026/_preview/66/build/titan_data_flow-152806ddbdc725fb3789a63ecc965244.png","width":800,"key":"Mv1plzGEun","urlSource":"./images/titan_data_flow.png"},{"type":"heading","depth":2,"position":{"start":{"line":40,"column":1},"end":{"line":40,"column":1}},"children":[{"type":"strong","position":{"start":{"line":40,"column":1},"end":{"line":40,"column":1}},"children":[{"type":"text","value":"Tutorial Overview","position":{"start":{"line":40,"column":1},"end":{"line":40,"column":1}},"key":"c7sBQ7X56L"}],"key":"syD6DOundB"}],"identifier":"tutorial-overview","label":"Tutorial Overview","html_id":"tutorial-overview","implicit":true,"key":"yjZnfQmqE2"},{"type":"heading","depth":3,"position":{"start":{"line":41,"column":1},"end":{"line":41,"column":1}},"children":[{"type":"text","value":"1. Setup","position":{"start":{"line":41,"column":1},"end":{"line":41,"column":1}},"key":"jpGtdRIfWg"}],"identifier":"id-1-setup","label":"1. Setup","html_id":"id-1-setup","implicit":true,"key":"jWt3leLYG9"},{"type":"heading","depth":4,"position":{"start":{"line":43,"column":1},"end":{"line":43,"column":1}},"children":[{"type":"te