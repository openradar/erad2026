,"html_id":"environment-and-packages","implicit":true,"key":"nRdXLznVlV"},{"type":"paragraph","position":{"start":{"line":88,"column":1},"end":{"line":88,"column":1}},"children":[{"type":"text","value":"First, we import the required python packages to run this notebook. Most of the LROSE processing can be done with the os package and shell commands.","position":{"start":{"line":88,"column":1},"end":{"line":88,"column":1}},"key":"rjcVwtRbXZ"}],"key":"zIqT5eTRjB"}],"key":"EyD1Rj8s7o"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"import os\nimport warnings\n\nwarnings.filterwarnings(\"ignore\")","key":"J6mI9yQ3HZ"},{"type":"outputs","id":"DB3CXIWPp7QX7AyTBX7xf","children":[],"key":"G5kdrJ1wLA"}],"key":"aIaHvR5PU3"},{"type":"block","children":[{"type":"heading","depth":3,"position":{"start":{"line":97,"column":1},"end":{"line":97,"column":1}},"children":[{"type":"text","value":"1.1 Set up directories","position":{"start":{"line":97,"column":1},"end":{"line":97,"column":1}},"key":"Joq0bIVnwJ"}],"identifier":"id-1-1-set-up-directories","label":"1.1 Set up directories","html_id":"id-1-1-set-up-directories","implicit":true,"key":"gJDYfLwEjf"},{"type":"paragraph","position":{"start":{"line":99,"column":1},"end":{"line":99,"column":1}},"children":[{"type":"text","value":"We need to set up the required data directories. The raw radar data will be grabbed from the S3 bucket.","position":{"start":{"line":99,"column":1},"end":{"line":99,"column":1}},"key":"SVtTRQbFLA"}],"key":"cspC2gRIy0"}],"key":"YxbiXOBWTn"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# make overall titan directory and application output directory\n!mkdir -p ../data/titan/titan\n\n# make directory for output ascii files from Titan\n!mkdir -p ../data/titan/titan/ascii","key":"jZX0tbouT4"},{"type":"outputs","id":"nC4CgN3gWbQIST8djtIQU","children":[],"key":"IQa9Bis9b3"}],"key":"CdjyboSaIp"},{"type":"block","children":[{"type":"heading","depth":3,"position":{"start":{"line":109,"column":1},"end":{"line":109,"column":1}},"children":[{"type":"text","value":"1.2 Set up the environment","position":{"start":{"line":109,"column":1},"end":{"line":109,"column":1}},"key":"mnTsSs4gfs"}],"identifier":"id-1-2-set-up-the-environment","label":"1.2 Set up the environment","html_id":"id-1-2-set-up-the-environment","implicit":true,"key":"l6MYmgiWVR"},{"type":"paragraph","position":{"start":{"line":111,"column":1},"end":{"line":111,"column":1}},"children":[{"type":"text","value":"First, we’ll set some key variables we’ll need throughout the workflow.","position":{"start":{"line":111,"column":1},"end":{"line":111,"column":1}},"key":"TpGFqiJcOa"}],"key":"mzYqaT50zc"}],"key":"siJK9D5gHK"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# Set directory variable to call LROSE\nos.environ[\"LROSE_DIR\"] = \"/usr/local/lrose/bin\"\nos.environ[\"DATA_DIR\"] = \"../data/titan\"","key":"xgOP3gANSz"},{"type":"outputs","id":"126NHrO9AIuksTY2c3fCr","children":[],"key":"WbEUzxKNhj"}],"key":"PtVAaMZ6BV"},{"type":"block","children":[{"type":"heading","depth":3,"position":{"start":{"line":119,"column":1},"end":{"line":119,"column":1}},"children":[{"type":"text","value":"1.3 Get data","position":{"start":{"line":119,"column":1},"end":{"line":119,"column":1}},"key":"OOhiZ73up2"}],"identifier":"id-1-3-get-data","label":"1.3 Get data","html_id":"id-1-3-get-data","implicit":true,"key":"WF4guWmCrj"},{"type":"paragraph","position":{"start":{"line":121,"column":1},"end":{"line":121,"column":1}},"children":[{"type":"text","value":"Because some of the preprocessing requires ancillary data, we need to grab and untar that data.","position":{"start":{"line":121,"column":1},"end":{"line":121,"column":1}},"key":"rQ3XUNKgeX"}],"key":"JIoRDOaBqh"}],"key":"uYtmuMcyNo"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"import fsspec\nimport shutil\n\n# Remote endpoint and path\nURL = \"https://js2.jetstream-cloud.org:8001/\"\npath = \"pythia/radar/ams2025\"\n\n# Initialize filesystem\nfs = fsspec.filesystem(\"s3\", anon=True, client_kwargs=dict(endpoint_url=URL))\n\n# Get list of files (example: Ontario Derecho)\nfiles = fs.glob(f\"{path}/OntarioDerecho2022/2022052115*.h5\")\n\n# Local base directory where you want to store files\nlocal_base = \"../data/titan/raw/derecho\"\n\nfor remote_file in files:\n    # Construct local file path, preserving the relative directory structure\n    rel_path = os.path.relpath(remote_file, start=path)  \n    local_file = os.path.join(local_base, rel_path)\n\n    # Ensure parent directories exist\n    os.makedirs(os.path.dirname(local_file), exist_ok=True)\n\n    # Open remote and local files and copy\n    with fs.open(remote_file, \"rb\") as fsrc, open(local_file, \"wb\") as fdst:\n        shutil.copyfileobj(fsrc, fdst)\n\n    print(f\"Downloaded {remote_file} -> {local_file}\")","key":"wuzzG5ylGk"},{"type":"outputs","id":"IEt1Acrresxkg1gVxyqqF","children":[{"type":"output","children":[],"jupyter_data":{"output_type":"stream","name":"stdout","text":"Downloaded pythia/radar/ams2025/OntarioDerecho2022/2022052115_00_ODIMH5_PVOL6S_VOL_CASET.h5 -> ../data/titan/raw/derecho/OntarioDerecho2022/2022052115_00_ODIMH5_PVOL6S_VOL_CASET.h5\n"},"key":"iBKpsWIN1B"},{"type":"output","children":[],"jupyter_data":{"output_type":"stream","name":"stdout","text":"Downloaded pythia/radar/ams2025/OntarioDerecho2022/2022052115_00_ODIMH5_PVOL6S_VOL_CASKR.h5 -> ../data/titan/raw/derecho/OntarioDerecho2022/2022052115_00_ODIMH5_PVOL6S_VOL_CASKR.h5\n"},"key":"Na5hE8y4Rx"},{"type":"output","children":[],"jupyter_data":{"output_type":"stream","name":"stdout","text":"Downloaded pythia/radar/ams2025/OntarioDerecho2022/2022052115_06_ODIMH5_PVOL6S_VOL_CASET.h5 -> ../data/titan/raw/derecho/OntarioDerecho2022/2022052115_06_ODIMH5_PVOL6S_VOL_CASET.h5